{
  "name": "nuget-code-workspace",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo watch dev",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit -p scripts/tsconfig.json && turbo typecheck",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run --dir scripts && turbo test",
    "package": "tsx scripts/package.ts",
    "console-module": "tsx scripts/console-module.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.18.0"
}
